# Common ARMv8-M files (includes common/ and arm_m/)

include armv8-m/Make.defs
VPATH += armv8-m

# The start-up, "head", file.

HEAD_ASRC = arm_head.S

# STM32N6 chip-specific sources

CHIP_CSRCS += stm32_start.c
CHIP_CSRCS += stm32_clockconfig.c
CHIP_CSRCS += stm32_gpio.c
CHIP_CSRCS += stm32_uart.c
CHIP_CSRCS += stm32_lowputc.c
CHIP_CSRCS += stm32_irq.c
CHIP_CSRCS += stm32_timer.c
CHIP_CSRCS += stm32_serial.c

ifeq ($(CONFIG_STM32N6_I2C1),y)
CHIP_CSRCS += stm32_i2c.c
else ifeq ($(CONFIG_STM32N6_I2C2),y)
CHIP_CSRCS += stm32_i2c.c
else ifeq ($(CONFIG_STM32N6_I2C3),y)
CHIP_CSRCS += stm32_i2c.c
else ifeq ($(CONFIG_STM32N6_I2C4),y)
CHIP_CSRCS += stm32_i2c.c
endif

ifeq ($(CONFIG_STM32N6_SPI1),y)
CHIP_CSRCS += stm32_spi.c
else ifeq ($(CONFIG_STM32N6_SPI2),y)
CHIP_CSRCS += stm32_spi.c
else ifeq ($(CONFIG_STM32N6_SPI3),y)
CHIP_CSRCS += stm32_spi.c
endif

ifeq ($(CONFIG_STM32N6_LTDC),y)
CHIP_CSRCS += stm32_ltdc.c
endif

ifeq ($(CONFIG_ARCH_CHIP_STM32N647),y)
CHIPDEF = -DSTM32N647
endif

ARCHDEFINES += $(CHIPDEF)
ARCHINCLUDES += -I$(TOPDIR)/arch/arm/src/stm32n6
ARCHINCLUDES += -I$(TOPDIR)/arch/arm/src/stm32n6/hardware
