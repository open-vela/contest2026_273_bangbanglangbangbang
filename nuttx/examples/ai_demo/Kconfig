#
# examples/ai_demo/Kconfig
#

config EXAMPLES_AI_DEMO
	bool "AI Demo Application"
	default y
	depends on AI
	depends on AI_TINYML
	depends on AI_AGENT
	---help---
		Enable the AI Demo application that demonstrates TinyML
		image classification with AI Agent integration.

		The demo shows the "cerebellum + brain" architecture:
		- TinyML (Cortex-M55 + Helium MVE) for local inference
		- AI Agent (Cloud LLM) for coordination and user interaction
		- Camera capture, LCD display, thermal printer output

		Usage: ai_demo [-h] [-c] [-s] [-t] [-a]
		  -h  Show help
		  -c  Run continuous classification
		  -s  Run single classification (default)
		  -t  Test TinyML inference engine
		  -a  Test AI Agent tools
