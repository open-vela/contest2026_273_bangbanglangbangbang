#
# drivers/ai/Make.defs
#

# Include AI source files

ifeq ($(CONFIG_AI),y)

# TinyML engine

ifeq ($(CONFIG_AI_TINYML),y)
CSRCS += tinyml/tinyml_engine.c
endif

# CMSIS-NN operations

ifeq ($(CONFIG_AI_CMSIS_NN),y)
CSRCS += tinyml/cmsis_nn_ops.c
endif

# Image classifier example

ifeq ($(CONFIG_AI_IMG_CLASSIFIER),y)
CSRCS += tinyml/img_classifier.c
endif

# AI Agent bridge

ifeq ($(CONFIG_AI_AGENT),y)
CSRCS += ai_agent_bridge.c
endif

endif # CONFIG_AI
